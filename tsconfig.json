
{
  "compilerOptions": {
    "lib": [
      "ESNext",
    ],
    "outDir": "dist",
    "rootDir": ".",
    "module": "nodenext",
    "target": "ESNext",
    "esModuleInterop": true,
    "moduleResolution": "nodenext",
    "alwaysStrict": true,
    "allowUnreachableCode": false,
    "strictNullChecks": true,
    "skipLibCheck": true
  },
  "include": ["./src/**/*.ts", "./scripts/**/*.ts", "./test/**/*.ts"],
  "exclude": [
    "node_modules"
  ]
}
