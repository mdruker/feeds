{
  "name": "mdruker-feeds",
  "version": "0.5.0",
  "description": "mdruker's experimental feeds",
  "main": "dist/src/index.js",
  "repository": "git@github.com:mdruker/feeds.git",
  "author": "mdruker",
  "license": "MIT",
  "scripts": {
    "publishStaging": "tsc && node --env-file=.env.staging dist/scripts/publishFeedGen.js",
    "publishProduction": "tsc && node --env-file=.env.production dist/scripts/publishFeedGen.js",
    "unpublishStaging": "tsc && node --env-file=.env.staging dist/scripts/unpublishFeedGen.js",
    "unpublishProduction": "tsc && node --env-file=.env.production dist/scripts/unpublishFeedGen.js",
    "start": "node dist/src/index.js",
    "dev": "tsc && node dist/src/index.js",
    "migrate": "node dist/src/migrate.js",
    "test": "tsc && node --test 'dist/test/**/*.test.js'",
    "build": "tsc"
  },
  "dependencies": {
    "@atproto/api": "^0.29.1",
    "@atproto/identity": "^0.5.18",
    "@atproto/lexicon": "^0.7.17",
    "@atproto/oauth-client-node": "^0.5.11",
    "@atproto/syntax": "^0.7.7",
    "@atproto/xrpc-server": "^0.13.5",
    "@skyware/jetstream": "^0.2.5",
    "async-mutex": "^0.5.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "iron-session": "^9.0.1",
    "kysely": "^0.29.7",
    "multiformats": "^13.3.1",
    "mysql2": "^3.14.2",
    "ws": "^8.18.0",
    "yocto-queue": "^1.1.1"
  },
  "devDependencies": {
    "@atproto/lex-cli": "^0.10.16",
    "@inquirer/prompts": "^8.7.4",
    "@types/express": "^5.0.6",
    "@types/node": "24",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">= 22",
    "yarn": "1"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
